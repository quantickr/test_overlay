# Скопируйте в .env и заполните своими значениями (https://my.telegram.org)
TG_API_ID=12345678
TG_API_HASH=0123456789abcdef0123456789abcdef
# "me" — Избранное; "@username"; или числовой id группы (-100...)
TG_TARGET_CHAT=me
# Опционально: SOCKS5-прокси в формате socks5:ХОСТ:ПОРТ
# TG_PROXY=socks5:127.0.0.1:10808
